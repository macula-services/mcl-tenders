{application, mcl_tenders_sensor, [
    {description, "Public tender sensor: reads new TED notices and reports each as one mesh fact"},
    {vsn, "0.1.0"},
    {registered, [mcl_tenders_sensor_sup]},
    {mod, {mcl_tenders_sensor_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% The TED sweep and the fact it reports.
        sense_tender_notices
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-tenders"}]}
]}.
