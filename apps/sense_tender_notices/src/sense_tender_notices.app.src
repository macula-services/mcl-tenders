{application, sense_tender_notices, [
    {description, "Gathering: reads new public tender notices from TED and reports each as one mesh fact, tender_notice_reported_v1"},
    {vsn, "0.1.0"},
    %% A LIBRARY APPLICATION, no `mod'. The sensor release starts its one
    %% process (sense_ted_notices) under mcl_tenders_sensor_sup; the company
    %% node's release builds against mcl_tenders_facts, the one schema both
    %% sides share, and starts nothing from here.
    {registered, [sense_ted_notices]},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% HTTP client and TLS for TED's Search API. JSON is OTP's own `json'.
        inets,
        ssl,
        public_key,
        %% The fact's topic (macula_topic) and its publish (mcl_om_pubsub).
        mcl_om
    ]},
    {env, [
        %% How often TED is swept, in ms. Before a release appears a sweep is
        %% one request with an empty answer. MCL_TENDERS_POLL_MS overrides.
        {poll_ms, 900000},
        %% How many publication numbers are remembered, so a sweep never
        %% reports a notice twice: about eight release days. MCL_TENDERS_MAX_SEEN
        %% overrides.
        {max_seen, 30000},
        %% How many days before today a fresh sensor starts from. 0 reports
        %% today's release and on. MCL_TENDERS_LOOKBACK_DAYS overrides.
        {lookback_days, 0}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-tenders"}]}
]}.
