{application, sense_tender_notices, [
    {description, "Gathering: reads new TED notices in the realm's CPV codes and countries and reports each as one sealed fact, tender_notice_reported_v1"},
    {vsn, "0.2.0"},
    %% A LIBRARY APPLICATION, no `mod'. The mcl_tenders release starts its
    %% one process (sense_ted_notices) under mcl_tenders_sup, after the store
    %% and the read side are up; guide_tender_lifecycle builds against
    %% mcl_tenders_facts, the one schema both sides share.
    {registered, [sense_ted_notices]},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% HTTP client and TLS for TED's Search API. JSON is OTP's own `json'.
        inets,
        ssl,
        public_key,
        %% The fact's topic (macula_topic), its sealed publish (macula:publish/5
        %% under the realm's tenders group, through mcl_om_pubsub).
        macula,
        mcl_om,
        %% The realm's profile, read in process before each sweep.
        query_tenders
    ]},
    {env, [
        %% How often TED is swept, in ms. Before a release appears a sweep is
        %% one request with an empty answer. MCL_TENDERS_POLL_MS overrides.
        {poll_ms, 900000},
        %% How many publication numbers are remembered, so a sweep never
        %% reports a notice twice: about eight release days. MCL_TENDERS_MAX_SEEN
        %% overrides.
        {max_seen, 30000},
        %% How many days before today a fresh sensor starts from. 0 reports
        %% today's release and on. MCL_TENDERS_LOOKBACK_DAYS overrides.
        {lookback_days, 0}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-tenders"}]}
]}.
