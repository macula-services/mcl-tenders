{application, project_tenders, [
    {description, "PRJ: projects the process's events into the SQLite read model query_tenders answers from"},
    {vsn, "0.2.0"},
    {registered, [project_tenders_sup, tenders_read_model_store]},
    {mod, {project_tenders_app, []}},
    {applications, [
        kernel,
        stdlib,
        %% The projections are evoq_event_handlers, fed by the store
        %% subscription mcl_tenders_app opens after this app has started.
        evoq,
        reckon_evoq,
        esqlite
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
