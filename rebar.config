%% -*- mode: erlang -*-
%% rebar3 configuration for mcl-tenders.
%%
%% Matched public tenders without sharing the profile. One repository, two
%% release images (macula-services/mcl-tenders#1):
%%
%%   mcl_tenders_sensor  the sensor: sweeps TED and reports each new notice as
%%                       one mesh fact. Apps: mcl_tenders_sensor (the mcl_om
%%                       service), sense_tender_notices (the sweep and the fact).
%%
%% The company node's release joins this file with its own package (#3).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively, and no persistence: since 0.35.0
    %% mcl_om starts no reckon-db or evoq application. The floor is the mcl_om
    %% this scaffold came from, so it moves with every mcl_om release and
    %% generated_service_floor_is_this_release fails when it does not.
    {mcl_om, "~> 1.6"},
    %% THE WIRE, NAMED, so the next mcl_om cannot move it unnoticed: 18.0 keeps
    %% wire 1.0, and naming it makes a mcl_om that reaches for another wire
    %% clash here at resolve time instead of drifting onto it.
    {macula, "~> 18.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural floor (macula-codebase-checks#9), matching the sibling
%% services: nesting 2, no nested try/catch, no if, functions at most 60 lines.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula and mcl_om are named, so calls into them are checked rather than
%% excused as unknown.
{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [macula, mcl_om]}
]}.

{relx, [
    {release, {mcl_tenders_sensor, "0.1.0"}, [mcl_tenders_sensor, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
